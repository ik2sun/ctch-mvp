# Supabase 프로젝트 설정 > API 에서 복사 (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 배포 시 실제 도메인 (로컬은 그대로 두세요)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apify (브랜드 분석 — 인스타그램 프로필 수집). 없으면 샘플 데이터로 대체됩니다.
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 회원 승인 시스템 — 이 이메일로 가입하면 자동으로 최고관리자(superadmin)로 승인됩니다.
SUPERADMIN_EMAIL=owner@nmg.co.kr

# Supabase 프로젝트 설정 > API > service_role 키. 관리자 승인/역할변경에 필요 (RLS 우회).
# 절대 클라이언트에 노출되지 않아야 하며, 서버 전용 코드에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 브랜드 키워드 모니터링 — 침해 감지 시 담당자 메일 발송 (https://resend.com 가입 후 API Keys에서 발급)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 발신자 표시 이름/주소. Resend에 도메인을 등록·인증하기 전까지는 기본값(onboarding@resend.dev)만 발송 가능합니다.
RESEND_FROM_EMAIL=CTCH 알림 <onboarding@resend.dev>

# Vercel Cron이 /api/cron/* 엔드포인트를 호출할 때 쓰는 인증 토큰 (임의의 랜덤 문자열)
CRON_SECRET=

# 카카오모먼트 연동 — 카카오디벨로퍼스(developers.kakao.com) 비즈 앱의 REST API 키 / 보안 > Client Secret.
# 앱에 '카카오모먼트' 사용 권한 신청·승인이 필요하고, 카카오 로그인 Redirect URI에
# {NEXT_PUBLIC_SITE_URL}/api/kakao-moment/oauth/callback 을 등록해야 합니다. 광고주별 토큰은 clients 행에 저장됩니다(0013 마이그레이션).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 선택: 콜백 주소를 직접 지정할 때 (기본값은 NEXT_PUBLIC_SITE_URL + /api/kakao-moment/oauth/callback)
KAKAO_REDIRECT_URI=
# 선택: 카카오가 비즈니스 동의항목 scope를 요구하는 경우에만 (쉼표 구분)
KAKAO_OAUTH_SCOPE=

# 숏폼 Veo 자동 생성 — 사내 렌더 워커(short-form/worker/render_worker.py)가 Gemini API(Veo 3.1)로 클립을 만들 때 사용.
# 소재 생성 > 이미지 생성의 'Google Nano Banana 2'(gemini-3.1-flash-image)도 이 키를 쓰므로 웹(Vercel)에도 넣어야 합니다.
# 워커는 없으면 ~/.claude/skills/claude-video/.env 의 값을 대신 읽습니다.
GEMINI_API_KEY=

# 소재 생성 > 이미지 생성의 'OpenAI GPT Image 2'(gpt-image-2). platform.openai.com → API keys
OPENAI_API_KEY=
